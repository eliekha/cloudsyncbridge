#!/bin/bash

# CloudSyncBridge Configuration Template
# This file is generated automatically by the installer

# Source: External drive to back up
# Example: /Volumes/MyExternalDrive
SOURCE_DRIVE="/Volumes/YOUR_DRIVE_NAME"

# Destination: iCloud Drive folder
ICLOUD_DRIVE="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
BACKUP_FOLDER="$ICLOUD_DRIVE/ExternalDrive_Backup"

# Folders to exclude (relative to source drive)
# The installer will let you interactively select which folders to exclude
EXCLUDE_FOLDERS=(
    ".Spotlight-V100"
    ".DocumentRevisions-V100"
    ".TemporaryItems"
    ".Trashes"
    ".fseventsd"
)

# File patterns to exclude
EXCLUDE_PATTERNS=(
    "*.env"
    ".DS_Store"
    "._*"
)

# Log file location
LOG_DIR="$HOME/Library/Logs/icloud_backup"
LOG_FILE="$LOG_DIR/sync.log"
